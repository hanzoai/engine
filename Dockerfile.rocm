# syntax=docker/dockerfile:1

# ROCm/HIP image for AMD GPUs. Defaults to gfx942 (MI300, ROCm 6.4); set
# ROCM_GFX_ARCH=gfx90a for MI200. For gfx1151 (Strix Halo) pass a ROCm 7.x base
# (ROCM_BASE=rocm/dev-ubuntu-24.04:7.2.4) plus ROCM_GFX_ARCH=gfx1151.
ARG ROCM_BASE=rocm/dev-ubuntu-24.04:6.4.4

# Stage 1: Build environment
FROM ${ROCM_BASE} AS builder
SHELL ["/bin/bash", "-e", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
RUN <<HEREDOC
    apt-get update
    apt-get install -y --no-install-recommends \
        curl \
        git \
        libclang-dev \
        libssl-dev \
        pkg-config

    rm -rf /var/lib/apt/lists/*
HEREDOC

RUN curl https://sh.rustup.rs -sSf | bash -s -- -y
ENV ROCM_PATH=/opt/rocm
ENV PATH="/root/.cargo/bin:/opt/rocm/bin:${PATH}"
RUN rustup update nightly && rustup default nightly

WORKDIR /hanzo
COPY . .

# Rayon threads are limited to minimize memory requirements in CI, avoiding OOM
# Rust threads are increased with a nightly feature for faster compilation (single-threaded by default)
# ROCM_GFX_ARCH is read by build.rs to compile the HIP kernels for the target ISA
ARG ROCM_GFX_ARCH=gfx942
ENV ROCM_GFX_ARCH=${ROCM_GFX_ARCH}
ARG RAYON_NUM_THREADS=4
ARG RUST_NUM_THREADS=4
ARG RUSTFLAGS="-Z threads=${RUST_NUM_THREADS}"
ARG WITH_FEATURES="rocm"
RUN cargo build --release --workspace --exclude hanzo-pyo3 --features "${WITH_FEATURES}"


# Stage 2: Minimal runtime environment
FROM ${ROCM_BASE} AS runtime
SHELL ["/bin/bash", "-e", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
RUN <<HEREDOC
    apt-get update
    apt-get install -y --no-install-recommends \
        libomp-dev \
        ca-certificates \
        libssl-dev \
        curl \
        pkg-config

    rm -rf /var/lib/apt/lists/*
HEREDOC

COPY --chmod=755 --from=builder /hanzo/target/release/hanzo-bench /usr/local/bin/hanzo-bench
COPY --chmod=755 --from=builder /hanzo/target/release/hanzo-server /usr/local/bin/hanzo-server
# Copy chat templates for users running models which may not include them
COPY --from=builder /hanzo/chat_templates /chat_templates

ENV HUGGINGFACE_HUB_CACHE=/data \
    PORT=80
